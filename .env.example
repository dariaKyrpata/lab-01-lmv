# Node can read this with --env-file=.env. Hosting variables belong in the hosting dashboard.
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info
LOG_DIR=./logs
ALLOWED_ORIGINS=http://127.0.0.1:3000,http://127.0.0.1:5173
MAX_CONNECTIONS_PER_IP=16
MAX_ROOMS=100
MAX_PLAYERS_PER_ROOM=4
TRUST_PROXY=0
BUILD_SHA=dev
